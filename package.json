{
  "name": "product-api",
  "version": "1.0.0",
  "description": "Phase 1 - Product REST API (Node.js, Express, Mongoose, MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --coverage --testPathIgnorePatterns=integration",
    "test:integration": "cross-env NODE_ENV=test jest --runInBand tests/products.integration.test.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.6.0",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0"
  }
}
